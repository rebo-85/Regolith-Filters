{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "node scripts/release.js ${input:releaseType}",
      "problemMatcher": [],
      "label": "Release Regolith Filters"
    }
  ],
  "inputs": [
    {
      "id": "releaseType",
      "type": "pickString",
      "description": "Select the release bump type:",
      "options": ["patch", "minor", "major"],
      "default": "patch"
    }
  ]
}
